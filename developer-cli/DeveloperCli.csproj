<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <AssemblyName>pp</AssemblyName>
        <PublishSingleFile>true</PublishSingleFile>
        <RootNamespace>DeveloperCli</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <UserSecretsId>platformplatform-f817f2a1-ac57-4756-aef2-a57ca864bbd3</UserSecretsId>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Bogus" Version="35.6.5" />
        <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" />
        <PackageReference Include="Karambolo.PO" Version="1.13.0" />
        <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.9" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
        <PackageReference Include="Spectre.Console" Version="0.57.0" />
        <PackageReference Include="System.CommandLine" Version="2.0.9" />
    </ItemGroup>
    <ItemGroup>
        <None Remove="DeveloperCli.slnx" />
        <None Remove="DeveloperCli.slnx.DotSettings" />
        <None Remove="Directory.Build.props" />
    </ItemGroup>
    <ItemGroup>
        <!-- The test project lives beside the CLI but is a separate project in the application solution. -->
        <Compile Remove="Tests\**" />
        <None Remove="Tests\**" />
    </ItemGroup>
    <ItemGroup>
        <!-- Linked source from shared-kernel: developer-cli is a single-file CLI that intentionally
             stays isolated from shared-kernel's heavy dependency closure (MediatR, EFCore, NSwag,
             OpenTelemetry, multiple Azure SDKs). PortAllocation and DockerVolumeNaming are the shared
             definitions; AppGateway and AppHost get them natively, developer-cli compiles the same files. -->
        <Compile Include="..\application\shared-kernel\SharedKernel\Configuration\PortAllocation.cs" Link="Utilities\PortAllocation.cs" />
        <Compile Include="..\application\shared-kernel\SharedKernel\Configuration\DockerVolumeNaming.cs" Link="Utilities\DockerVolumeNaming.cs" />
    </ItemGroup>
    <ItemGroup>
        <!-- Linked source from the SDK generator, for the same reason: `scaleway-sdk schemas` downloads the pinned
             schemas and the generator parses them, so both have to agree on which document a pin names. Compiling
             the files keeps one pin table instead of two, held to the schemas on disk by Scaleway.Sdk.Generator.Tests.
             They are dependency-free; the generator's YamlDotNet reference does not come with them. -->
        <Compile Include="..\application\shared-kernel\Scaleway.Sdk.Generator\SchemaPins.cs" Link="Utilities\SchemaPins.cs" />
        <Compile Include="..\application\shared-kernel\Scaleway.Sdk.Generator\SchemaVersionCheck.cs" Link="Utilities\SchemaVersionCheck.cs" />
        <Compile Include="..\application\shared-kernel\Scaleway.Sdk.Generator\SchemaVersionCache.cs" Link="Utilities\SchemaVersionCache.cs" />
    </ItemGroup>
    <ItemGroup>
        <!-- Scaleway.Sdk has no package dependencies (it is built to stand alone), so referencing it keeps the
             CLI isolated from shared-kernel's dependency closure while sharing one Scaleway client. -->
        <ProjectReference Include="..\application\shared-kernel\Scaleway.Sdk\Scaleway.Sdk.csproj" />
    </ItemGroup>
</Project>