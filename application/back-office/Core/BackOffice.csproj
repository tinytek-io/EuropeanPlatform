<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <AssemblyName>BackOffice</AssemblyName>
        <RootNamespace>BackOffice</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\shared-kernel\SharedKernel\SharedKernel.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <!-- The OIDC handler for staff sign-in (the package does not ship with the framework
             reference; SharedKernel pins the version in Directory.Packages.props). -->
        <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect"/>
    </ItemGroup>

</Project>
