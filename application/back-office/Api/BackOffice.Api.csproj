<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <AssemblyName>BackOffice.Api</AssemblyName>
        <RootNamespace>BackOffice.Api</RootNamespace>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- The back-office owns its SPA contract: the single OpenAPI document feeds the WebApp's
             openapi-typescript client generation. -->
        <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)\..\WebApp\shared\lib\api\</OpenApiDocumentsDirectory>
        <OpenApiGenerateDocuments>true</OpenApiGenerateDocuments>
        <OpenApiGenerateDocumentsOnBuild>true</OpenApiGenerateDocumentsOnBuild>
        <!-- Aspire's container publish is a self-contained linux-x64 build, whose assembly layout the
             OpenAPI document generator cannot load. The documents exist for SPA codegen in regular
             builds, so container publishes skip them. -->
        <OpenApiGenerateDocumentsOnBuild Condition="'$(SKIP_OPENAPI_DOCUMENTS)' == 'true'">false</OpenApiGenerateDocumentsOnBuild>
        <OpenApiGenerateDocuments Condition="'$(SKIP_OPENAPI_DOCUMENTS)' == 'true'">false</OpenApiGenerateDocuments>
        <DefaultItemExcludes>$(DefaultItemExcludes);publish\**;Dockerfile</DefaultItemExcludes>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Core\BackOffice.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" GeneratePathProperty="true">
            <IncludeAssets>runtime; build; native; contentFiles; analyzers; buildTransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Yarp.ReverseProxy"/>
    </ItemGroup>

    <!-- The Api serves the back-office WebApp bundle: the walk-up resolution in SharedKernel finds
    it at <project>/dist inside the container, copied into the publish output only (local
    development keeps resolving to the live source tree). The Condition guards against early-stage
    builds (e.g. test phase) where the frontend build has not run yet. -->
    <ItemGroup Condition="Exists('..\WebApp\dist')">
        <Content Include="..\WebApp\dist\**\*">
            <Link>WebApp\dist\%(RecursiveDir)%(Filename)%(Extension)</Link>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
    </ItemGroup>

</Project>
