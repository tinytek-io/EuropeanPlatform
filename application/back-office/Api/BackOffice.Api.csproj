<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <AssemblyName>BackOffice.Api</AssemblyName>
        <RootNamespace>BackOffice.Api</RootNamespace>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- Off until the SPA moves in at the back-office cutover: the shared SPA configuration
             (loaded at startup for document generation) requires the WebApp project folder, and
             the scaffold serves only /me. The cutover commit flips this on for SPA codegen. -->
        <OpenApiGenerateDocuments>false</OpenApiGenerateDocuments>
        <OpenApiGenerateDocumentsOnBuild>false</OpenApiGenerateDocumentsOnBuild>
        <!-- Aspire's container publish is a self-contained linux-x64 build, whose assembly layout the
             OpenAPI document generator cannot load. The documents exist for SPA codegen in regular
             builds, so container publishes skip them. -->
        <OpenApiGenerateDocumentsOnBuild Condition="'$(SKIP_OPENAPI_DOCUMENTS)' == 'true'">false</OpenApiGenerateDocumentsOnBuild>
        <OpenApiGenerateDocuments Condition="'$(SKIP_OPENAPI_DOCUMENTS)' == 'true'">false</OpenApiGenerateDocuments>
        <DefaultItemExcludes>$(DefaultItemExcludes);publish\**;Dockerfile</DefaultItemExcludes>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Core\BackOffice.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" GeneratePathProperty="true">
            <IncludeAssets>runtime; build; native; contentFiles; analyzers; buildTransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <!-- The container image must contain the SPA marker (WebApp/main.tsx) for the shared SPA
         configuration's startup walk-up. The cutover replaces the marker with the real WebApp and
         its dist bundle (Content Include of ..\WebApp\dist\** like the other API hosts). -->
    <ItemGroup>
        <Content Include="..\WebApp\main.tsx">
            <Link>WebApp\main.tsx</Link>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
    </ItemGroup>

</Project>
