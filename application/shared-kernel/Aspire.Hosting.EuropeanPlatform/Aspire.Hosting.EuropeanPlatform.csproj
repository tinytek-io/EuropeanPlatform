<Project Sdk="Microsoft.NET.Sdk">

    <!-- EuropeanPlatform's own Aspire hosting extensions: how the platform's self-contained systems run locally and
         deploy to Scaleway Kapsule. Opinionated on purpose: it encodes the platform's conventions rather than offering
         Scaleway's products generically. -->
    <PropertyGroup>
        <OutputType>Library</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Aspire.Hosting.EuropeanPlatform</RootNamespace>
        <!-- Aspire's evaluation-only publishing APIs: ASPIREPIPELINES001 gates builder.Pipeline, ASPIRECOMPUTE003 the
             container registry APIs. -->
        <NoWarn>$(NoWarn);ASPIREPIPELINES001;ASPIRECOMPUTE003</NoWarn>
    </PropertyGroup>

    <!-- shared-kernel's Directory.Build.props adds implicit usings for the application stack; a hosting library takes
         no MediatR dependency. -->
    <ItemGroup>
        <Using Remove="MediatR"/>
        <!-- The usings an AppHost gets implicitly from Aspire.AppHost.Sdk, which a library does not. -->
        <Using Include="Aspire.Hosting"/>
        <Using Include="Aspire.Hosting.ApplicationModel"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Aspire.Hosting"/>
        <PackageReference Include="Aspire.Hosting.Kubernetes"/>
        <PackageReference Include="Aspire.Hosting.PostgreSQL"/>
        <PackageReference Include="JetBrains.Annotations"/>
        <PackageReference Include="YamlDotNet"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Scaleway.Sdk\Scaleway.Sdk.csproj"/>
    </ItemGroup>

</Project>
